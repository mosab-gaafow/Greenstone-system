# Greenstone frontend environment example
#
# Copy to .env.local for local development:
#   cp .env.example .env.local
#
# Only values that are safe to expose in the browser belong in this file.
# Never put a secret behind NEXT_PUBLIC_.
# Authentication uses secure HTTP-only cookies set by the backend, so no
# token value is ever configured here.

# Origin of the Express backend.
# The Greenstone API is at <this>/api/v1 and Better Auth at <this>/api/auth.
# Must match FRONTEND_ORIGIN's counterpart in backend/.env.
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
