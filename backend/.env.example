# Greenstone backend environment example
#
# Copy to .env for local development:
#   cp .env.example .env
#
# Never commit a real .env file.
# Never log the values in this file.

# Application environment: development | test | staging | production
NODE_ENV=development

# Port the Express API listens on.
PORT=4000

# Origin allowed to call this API with credentials.
FRONTEND_ORIGIN=http://localhost:3000

# Logging level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# --- Database ---------------------------------------------------------------

# MySQL connection for this environment.
DATABASE_URL=mysql://user:password@127.0.0.1:3306/greenstone_dev

# Separate database used by the automated tests.
# The test suite deletes all data in it, and refuses to run unless the database
# name ends with "_test" and differs from DATABASE_URL.
TEST_DATABASE_URL=mysql://user:password@127.0.0.1:3306/greenstone_test

# --- Security ---------------------------------------------------------------

# Signs CSRF tokens. At least 32 characters.
# Generate a fresh value per environment, for example:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
CSRF_SECRET=change-me-to-a-long-random-value-min-32-chars

# General API rate limit.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- File storage -----------------------------------------------------------

# Only "local" exists today. Object storage is configured at deployment.
STORAGE_PROVIDER=local

# Private directory for development uploads. Never inside a public web folder.
STORAGE_LOCAL_PATH=./storage

# Maximum accepted upload size, in bytes. Default is 10 MB.
MAX_FILE_SIZE_BYTES=10485760

# Comma-separated list of accepted MIME types.
ALLOWED_FILE_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf

# --- PDF --------------------------------------------------------------------

# Only "stub" exists today. A real renderer is added in Phase 5.
PDF_RENDERER=stub

# ---------------------------------------------------------------------------
# Added in later phases. See docs/technical-blueprint.md section 12.6.
#
# Phase 2: JWT secrets, access and refresh token lifetimes, cookie settings.
#
# Do not add these keys before the phase that uses them.
# ---------------------------------------------------------------------------
