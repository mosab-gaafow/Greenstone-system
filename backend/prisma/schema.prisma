// Greenstone Management System — Prisma schema
//
// Phase 1: shared infrastructure (DocumentSequence, AuditLog).
// Phase 2: authentication, owned and generated by Better Auth (User, Session,
//          Account, Verification), plus the Greenstone UserCapabilityGrant.
// Phase 4A: Product.
// Phase 4B: Customer, CustomerAddress.
// Phase 4C: Employee, Driver, Vehicle.
// Phase 4D: Supplier, CompanySettings.
// Phase 5A: StoredFile, GeneratedDocument, Quotation, QuotationItem.
//           Quotation and QuotationItem removed in Phase 6C-3 (2026-08-02) —
//           see docs/decisions/business-workflow-update-2026-08-02.md.
// Phase 5B: Order, OrderItem, CustomerOpeningBalance, CustomerCreditOverride.
// Phase 6A: MeasurementUnit, RawMaterial, RawMaterialStockBalance,
//           RawMaterialMovement, FinishedStockBalance, FinishedStockMovement,
//           BrokenProductRecord.
// Phase 6B: ProductionBatch, ProductionItem, ProductionOrderAllocation,
//           RawMaterialUsage, CuringRecord.
// Phase 7A: SupplierOpeningBalance.
// Phase 7C: Purchase, PurchaseItem.
// Phase 7D: PurchasePayment, PurchasePaymentAllocation.
//
// Business entities are added from Phase 4 onward, in the phase that owns them.
//
// Deferred: Stock reservation and delivery dispatch (Phase 8 — will add a
// DELIVERY_DISPATCH writer on top of the finished-stock ledger already built
// in Phase 6A). See docs/implementation-plan.md.
//
// The Better Auth models are regenerated with:
//   pnpm --filter backend auth:generate
// Do not hand-edit their fields. Greenstone relations are appended separately
// and must be re-applied if the generator overwrites them.
//
// See docs/technical-blueprint.md sections 4.14, 6, 7.2 and 10.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7 no longer accepts `url` here.
// The connection URL lives in prisma.config.ts for the CLI, and is passed to
// PrismaClient through the driver adapter at runtime.

datasource db {
  provider = "mysql"
}

/// Document types that receive an official backend-generated number.
/// Values come from the approved numbering table (business-blueprint section 3).
///
/// `QUOTATION` is no longer issued (Quotations removed, Phase 6C-3,
/// 2026-08-02) but is deliberately kept here: `document_sequences` has a real
/// historical row with this value (year 2026), and issued document records
/// must never be hard-deleted or have their historical type invalidated.
/// Removing it from this enum would force a destructive rewrite of that row
/// or fail the migration outright. No code path allocates a new `QUOTATION`
/// number — the `quotations` module that did so is gone.
enum DocumentType {
  QUOTATION
  ORDER
  PRODUCTION
  DELIVERY
  INVOICE
  RECEIPT
  PURCHASE
  CUSTOMER_PAYMENT
  PURCHASE_PAYMENT
  SALARY_PAYMENT
  EXPENSE
}

/// One counter per document type per Africa/Nairobi calendar year.
/// Rows are locked with SELECT ... FOR UPDATE during number generation so that
/// simultaneous requests can never receive the same number.

model DocumentSequence {
  id           String       @id @default(uuid())
  documentType DocumentType
  year         Int
  lastNumber   Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([documentType, year])
  @@map("document_sequences")
}

/// Append-only history of sensitive actions.
///
/// Audit rows are written by backend services inside the same transaction as the
/// business change they describe. They are never updated or deleted.
///
/// `userId` uses `onDelete: SetNull` so an audit row always survives, even if a
/// user record is ever removed. The `userName` and `userRole` snapshots exist
/// precisely so the history stays readable when the link is gone.

model AuditLog {
  id             String   @id @default(uuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName       String?
  userRole       String?
  action         String
  module         String
  entityType     String
  entityId       String?
  documentNumber String?
  previousData   Json?
  updatedData    Json?
  reason         String?  @db.Text
  requestId      String?
  ipAddress      String?
  userAgent      String?  @db.Text
  createdAt      DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([module, action])
  @@index([createdAt])
  @@map("audit_logs")
}

/// How long a stored file must be kept. Only `PERMANENT` exists for the MVP
/// (generated official PDFs, and later customer-payment evidence) — see
/// docs/technical-blueprint.md section 8.5. More values may be added if a
/// future file type needs a shorter retention rule.
enum RetentionType {
  PERMANENT
}

/// File metadata. See docs/technical-blueprint.md section 4.14 and 8.
///
/// The binary itself lives in the configured storage provider
/// (`backend/src/shared/storage/`), never in MySQL — this table is metadata
/// only. `storageKey` is generated, never derived from a user-supplied name.
model StoredFile {
  id               String        @id @default(uuid())
  storageKey       String        @unique
  originalFileName String
  mimeType         String
  sizeBytes        Int
  checksum         String
  uploadedByUserId String?
  uploadedByUser   User?         @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  retentionType    RetentionType
  createdAt        DateTime      @default(now())

  generatedDocument       GeneratedDocument?
  purchasePaymentEvidence  PurchasePayment?
  customerPaymentEvidence  CustomerPayment?        @relation("CustomerPaymentEvidence")
  expenseEvidence          Expense?                 @relation("ExpenseEvidence")

  @@map("stored_files")
}

/// Restricts which business documents may have an official generated PDF —
/// see docs/business-blueprint.md section 9.1: "Other PDFs must not be added
/// unless approved." Deliberately a separate, narrower enum from
/// `DocumentType`, which covers every numbered document, not just PDFs.
///
/// `QUOTATION` was removed (Phase 6C-3, 2026-08-02) along with its one
/// generated PDF record — unlike `DocumentType`, no historical row keeps this
/// value, so narrowing the enum is safe here.
enum GeneratedDocumentType {
  INVOICE
  RECEIPT
}

/// The relation table linking a business record to its official generated
/// PDF — see docs/technical-blueprint.md section 4.14 ("Generated Document"
/// serves as the explicit relation table for "Generated PDF documents").
///
/// `relatedEntityId` is a plain id, not a foreign key: the same table will
/// serve Invoices/Receipts (Phase 9), and Prisma cannot express a
/// polymorphic relation. The service layer is responsible for loading the
/// right record for `documentType`. It previously also served Quotations
/// (Phase 5A), removed in Phase 6C-3.
///
/// A new version is created only when the rendered content actually changes
/// (compared by checksum) — repeat downloads of an unchanged draft reuse the
/// existing file rather than writing a duplicate. Old versions are never
/// deleted, so a past document remains traceable even after a later edit
/// produces a new one (business-blueprint section 9.6).
model GeneratedDocument {
  id              String                @id @default(uuid())
  documentType    GeneratedDocumentType
  relatedEntityId String
  documentNumber  String
  version         Int
  storedFileId    String                @unique
  storedFile      StoredFile            @relation(fields: [storedFileId], references: [id], onDelete: Restrict)
  generatedAt     DateTime              @default(now())

  @@unique([documentType, relatedEntityId, version])
  @@index([documentType, relatedEntityId])
  @@map("generated_documents")
}

/// Owned and generated by Better Auth. Do not hand-edit the Better Auth fields.
/// Greenstone relations are appended below them.
///
/// Deactivation is expressed through `banned`, set by the Admin plugin, which
/// also revokes the user's sessions.
model User {
  id            String    @id
  name          String    @db.Text
  email         String
  emailVerified Boolean   @default(false)
  image         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?   @db.Text
  banned        Boolean?  @default(false)
  banReason     String?   @db.Text
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]

  // Greenstone relations
  auditLogs                      AuditLog[]
  capabilityGrants               UserCapabilityGrant[]    @relation("CapabilityHolder")
  capabilitiesGranted            UserCapabilityGrant[]    @relation("CapabilityGranter")
  storedFiles                    StoredFile[]
  openingBalancesEntered         CustomerOpeningBalance[]
  supplierOpeningBalancesEntered SupplierOpeningBalance[]
  purchasesCreated               Purchase[]
  purchasePaymentsCreated        PurchasePayment[]        @relation("PurchasePaymentCreatedBy")
  purchasePaymentsApproved       PurchasePayment[]        @relation("PurchasePaymentApprovedBy")
  purchasePaymentsReversed       PurchasePayment[]        @relation("PurchasePaymentReversedBy")
  creditOverridesApproved        CustomerCreditOverride[]
  rawMaterialMovements           RawMaterialMovement[]
  finishedStockMovements         FinishedStockMovement[]
  brokenProductRecords           BrokenProductRecord[]
  productionBatchesCreated       ProductionBatch[]
  curingRecordsCreated           CuringRecord[]           @relation("CuringCreatedBy")
  curingRecordsChanged           CuringRecord[]           @relation("CuringDurationChangedBy")
  curingRecordsReleased          CuringRecord[]           @relation("CuringReleasedBy")
  deliveriesCreated              Delivery[]               @relation("DeliveryCreatedBy")
  deliveriesDispatched           Delivery[]               @relation("DeliveryDispatchedBy")
  deliveriesCancelled            Delivery[]               @relation("DeliveryCancelledBy")
  invoicesCreated                Invoice[]                @relation("InvoiceCreatedBy")
  invoicesVoided                 Invoice[]                @relation("InvoiceVoidedBy")
  paymentsRecorded               CustomerPayment[]        @relation("PaymentRecordedBy")
  paymentsApproved               CustomerPayment[]        @relation("PaymentApprovedBy")
  paymentsReversed               CustomerPayment[]        @relation("PaymentReversedBy")
  receiptsIssued                 Receipt[]                @relation("ReceiptIssuedBy")
  recordedExpenses               Expense[]                @relation("ExpenseRecordedBy")

  @@unique([email])
  @@map("user")
}

/// Approved per-user capabilities.
///
/// Greenstone-owned, deliberately separate from Better Auth roles, because these
/// are granted to an individual user rather than to a role.
///
/// Only the two capabilities in `Capability` are approved. See
/// docs/permissions-matrix.md section 4.
enum Capability {
  CURING_RELEASE
  SALARY_REGISTER
}

model UserCapabilityGrant {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation("CapabilityHolder", fields: [userId], references: [id], onDelete: Cascade)
  capability  Capability
  grantedById String?
  grantedBy   User?      @relation("CapabilityGranter", fields: [grantedById], references: [id], onDelete: SetNull)
  grantedAt   DateTime   @default(now())
  revokedAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId, capability])
  @@index([revokedAt])
  @@map("user_capability_grants")
}

/// Product categories.
///
/// The two categories Greenstone manufactures, per business-blueprint section
/// 2.3. Do not add a category that is not approved there.
enum ProductCategory {
  HOLLOW_BLOCK
  HOLLOW_POT
}

/// Product master.
///
/// Deliberately has **no selling price**. Greenstone agrees a price per customer
/// per transaction, and order and invoice items each store their own
/// price snapshot. A price here would eventually be mistaken for the real one.
///
/// See business-blueprint sections 2.3 and 2.4.
model Product {
  id                        String          @id @default(uuid())
  name                      String          @unique
  /// Lowercased, whitespace-collapsed, × treated as x. The unique index that
  /// actually prevents duplicates — `name` alone would let "6 x 9" and
  /// "6 × 9" become two products.
  nameNormalized            String          @unique
  category                  ProductCategory
  size                      String
  description               String?         @db.Text
  /// Short day-to-day name staff actually use (e.g. "4-inch"), separate from
  /// the full official `name` (2026-08-02/03). Nullable — left empty until
  /// confirmed for a given product; permanently empty for the two Hollow Pot
  /// 150mm/200mm products, a deliberate decision, not a placeholder.
  operationalName           String?
  /// Trimmed, case-normalised, internal whitespace collapsed — same
  /// nullable-but-unique-when-present pattern as `Customer.emailNormalized`.
  operationalNameNormalized String?         @unique
  /// Confirmed pieces one pallet of this product holds. Nullable — Production
  /// refuses to run for a product with no value here (business-blueprint
  /// section 2.7). Replaces the old global "one pallet is always 12 pieces"
  /// rule, which is no longer true for every product.
  piecesPerPallet           Int?
  /// Confirmed maximum pieces of this single product one truck can carry
  /// (2026-08-02). Nullable until confirmed. Applies only when a truck
  /// carries a single product type — mixed-product capacity is deferred.
  maxPiecesPerTruck         Int?
  isActive                  Boolean         @default(true)
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  orderItems             OrderItem[]
  finishedStockBalance   FinishedStockBalance?
  finishedStockMovements FinishedStockMovement[]
  brokenProductRecords   BrokenProductRecord[]
  productionItems        ProductionItem[]
  deliveryItems          DeliveryItem[]
  invoiceItems           InvoiceItem[]

  @@index([isActive])
  @@index([category])
  @@map("products")
}

/// Customer master.
///
/// A customer has many orders, and every order belongs to exactly one customer.
/// See business-blueprint section 2.2.
model Customer {
  id                 String   @id @default(uuid())
  name               String
  phone              String
  /// Digits only, in international form. This is what makes the customer
  /// unique: "0722123456", "0722 123 456" and "+254722123456" all normalise to
  /// the same value, so they can no longer be entered three times.
  phoneNormalized    String   @unique
  email              String?
  /// Lowercased. Unique when present; MySQL allows many NULLs in a unique
  /// index, so customers without an email are unaffected.
  emailNormalized    String?  @unique
  isActive           Boolean  @default(true)
  /// Written reason for the most recent deactivation (normal or forced).
  /// Mirrors `Order.statusReason`. Cleared when the customer is reactivated
  /// — the audit log keeps the permanent history regardless. See
  /// business-blueprint section 2.2/2.24 and
  /// docs/decisions/business-workflow-update-2026-08-02.md section 16.
  deactivationReason String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  addresses       CustomerAddress[]
  orders          Order[]
  openingBalance  CustomerOpeningBalance?
  creditOverrides CustomerCreditOverride[]
  deliveries      Delivery[]
  invoices        Invoice[]
  payments        CustomerPayment[]
  receipts        Receipt[]

  @@index([isActive])
  @@index([name])
  @@map("customers")
}

/// A customer's building-site or delivery address.
///
/// Modelled as a relationship rather than repeated text on an order, so the
/// same site can be selected across many orders and deliveries without being
/// retyped. An order selects one address belonging to its own customer, and a
/// delivery trip uses one address — never several locations.
///
/// `onDelete: Restrict` because a customer with addresses must never be
/// removed. Customers are deactivated, never deleted.
///
/// Phase 5B: an order **snapshots** the address text (`Order.addressLabel`
/// etc.) at the time it is placed, alongside this FK. Editing a site later
/// must not silently rewrite the address an existing order was sent to.
model CustomerAddress {
  id              String   @id @default(uuid())
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  /// Short name the yard recognises, for example "Kiambu Road site".
  label           String
  /// Lowercased and whitespace-collapsed. Unique per customer, so a driver
  /// reading a site name is never choosing between two.
  labelNormalized String
  addressLine     String
  /// Free-text directions for the driver.
  directions      String?  @db.Text
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orders     Order[]
  deliveries Delivery[]

  @@unique([customerId, labelNormalized])
  @@index([customerId, isActive])
  @@map("customer_addresses")
}

/// Employee salary frequency. See business-blueprint section 2.28.
enum SalaryFrequency {
  WEEKLY
  MONTHLY
}

/// Shared payment-method vocabulary.
///
/// Reused from the approved customer-payment method list (business-blueprint
/// section 2.23) rather than inventing a second one for employees.
enum PaymentMethod {
  MPESA
  CASH
  BANK_TRANSFER
  CHEQUE
}

enum ExpenseCategory {
  ELECTRICITY
  WATER
  RENT
  TRANSPORT
  MAINTENANCE
  SUPPLIES
  COMMUNICATION
  INSURANCE
  LICENSES
  OTHER
}

/// Employee master.
///
/// Only the master record and its salary fields live here. Salary payment
/// processing — registration, approval, correction, reversal — is a later
/// phase (technical-blueprint Implementation Phase 10).
model Employee {
  id              String          @id @default(uuid())
  name            String
  phone           String
  /// Kenyan ID number. Optional, and deliberately unvalidated in format —
  /// same permissive philosophy as phone numbers elsewhere in this schema.
  nationalId      String?
  jobTitle        String
  salaryFrequency SalaryFrequency
  salaryAmount    Decimal         @db.Decimal(12, 2)
  paymentMethod   PaymentMethod
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([isActive])
  @@index([name])
  @@map("employees")
}

/// Driver master. See business-blueprint section 2.20.
///
/// Not automatically a Greenstone employee — Driver and Employee are separate
/// master-data modules, and a driver never gains salary/employee fields.
model Driver {
  id                   String   @id @default(uuid())
  name                 String
  phone                String
  /// Readable, as entered (trimmed only).
  nationalId           String
  /// Trimmed, uppercased, internal whitespace collapsed. This is the column
  /// the uniqueness constraint and the duplicate check actually use, so
  /// "12345678" and " 12345678 " can never both be entered.
  nationalIdNormalized String   @unique
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  deliveries Delivery[]

  @@index([isActive])
  @@index([name])
  @@map("drivers")
}

/// Vehicle Owner master (2026-08-02/03, Phase 6F). See business-blueprint
/// section 2.20.
///
/// A separate master-data record from Driver, even when the same real person
/// is both — no automatic link or merge is created between the two. `phone`
/// follows the same dual-column normalisation as Customer; `nationalId` is
/// optional, following the same "unique when present" dual-column pattern as
/// Customer's email (nullable, `@unique` on the normalised column only).
model VehicleOwner {
  id                   String   @id @default(uuid())
  name                 String
  phone                String
  phoneNormalized      String   @unique
  /// Readable, as entered (trimmed only). Optional.
  nationalId           String?
  /// Trimmed, uppercased, internal whitespace collapsed. Nullable, but
  /// unique when present.
  nationalIdNormalized String?  @unique
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  vehicles   Vehicle[]
  deliveries Delivery[]

  @@index([isActive])
  @@index([name])
  @@map("vehicle_owners")
}

/// Vehicle master. See business-blueprint section 2.20 and
/// docs/decisions/business-workflow-update-2026-08-02.md sections 10-12.4.
///
/// Hired-only for the MVP: Greenstone owns no vehicles yet, but Vehicle no
/// longer has an `ownershipType` category at all (Phase 6F) — every vehicle
/// has a registered `VehicleOwner` instead. The pairing of Driver and
/// Vehicle happens per Delivery trip (Phase 8), never as a fixed property of
/// either record.
///
/// **Phase 6F removed** the old volumetric truck-load fields
/// (`truckLengthM`, `truckWidthM`, `truckHeightM`, `calculationFactor`,
/// `calculatedLoadKg`, `calculatedLoadTonnes`, added in Phase 4C) and the
/// `ownershipType`/`VehicleOwnershipType` enum entirely — the calculation was
/// based on a misunderstanding: `1100` is the Pumice purchase rate (KES per
/// cubic metre), not a vehicle weight/capacity factor. `vehicleOwnerId` is
/// required — the 3 pre-existing Vehicle rows were backfilled with real
/// (demo) Vehicle Owner records before this migration, never invented ones.
///
/// There is deliberately no hire-cost or transport-rate field — a vehicle
/// does not have one permanent price. Actual transport cost varies per
/// delivery trip and belongs to a later Delivery/transport-payment workflow
/// (not implemented in Phase 6F).
model Vehicle {
  id                     String @id @default(uuid())
  registrationNumber     String
  /// Uppercased, with every separator character (spaces, hyphens, and
  /// similar) stripped — "KDA 123X", "kda-123x", and "kda123x" are the same
  /// plate and must not become two records. See `normalizeRegistration` in
  /// `shared/utils/normalize.ts` (fixed 2026-08-04 — the original version
  /// only removed whitespace, letting a hyphenated duplicate through).
  registrationNormalized String @unique
  vehicleType            String

  /// `onDelete: Restrict` — a Vehicle Owner is deactivated, never
  /// hard-deleted, matching every other master-data relation in this schema.
  vehicleOwnerId String
  vehicleOwner   VehicleOwner @relation(fields: [vehicleOwnerId], references: [id], onDelete: Restrict)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries Delivery[]

  @@index([isActive])
  @@index([vehicleOwnerId])
  @@map("vehicles")
}

/// Supplier master. See business-blueprint section 2.16.
///
/// Master record only — opening balances, purchases, and purchase payments
/// (business-blueprint sections 2.17–2.18) belong to Phase 7, once
/// raw-material stock exists for a purchase to receive into.
model Supplier {
  id              String   @id @default(uuid())
  name            String
  phone           String
  /// Digits only, in international form — same normalisation as Customer
  /// phone, so the same number entered two different ways is one supplier.
  phoneNormalized String   @unique
  email           String?
  /// Lowercased. Unique when present; MySQL allows many NULLs in a unique
  /// index, so suppliers without an email are unaffected.
  emailNormalized String?  @unique
  /// Free text. Not normalised or unique — descriptive, not an identity field.
  address         String?  @db.Text
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  openingBalance   SupplierOpeningBalance?
  purchases        Purchase[]
  purchasePayments PurchasePayment[]

  @@index([isActive])
  @@index([name])
  @@map("suppliers")
}

/// The supplier's opening balance — money Greenstone already owed the
/// supplier before this system started. See business-blueprint section 2.18
/// and docs/implementation-plan.md Phase 7A.
///
/// Corrected in place rather than accumulated as history rows — one row per
/// supplier — with full before/after history in the audit log. Identical
/// shape to `CustomerOpeningBalance`, which established this pattern in
/// Phase 5B.
///
/// It is not a Purchase, not a Purchase Payment, and not a General Expense —
/// it exists so the supplier's outstanding balance calculation has a
/// traceable starting point, nothing more.
model SupplierOpeningBalance {
  id              String   @id @default(uuid())
  supplierId      String   @unique
  supplier        Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  amount          Decimal  @db.Decimal(14, 2)
  effectiveDate   DateTime
  reason          String   @db.Text
  enteredByUserId String?
  enteredByUser   User?    @relation(fields: [enteredByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("supplier_opening_balances")
}

/// Purchase master. See business-blueprint section 2.16 and
/// docs/implementation-plan.md Phase 7C.
///
/// Belongs to one supplier. Creating a purchase is receiving it — there is
/// no separate "mark as received" step, matching the approved `purchase`
/// permission (create, read only). **No update or delete route**: a
/// purchase, once recorded, is never edited — the same "never edited, only
/// ever created" shape `ProductionBatch` already established.
model Purchase {
  id              String   @id @default(uuid())
  purchaseNumber  String   @unique
  supplierId      String
  supplier        Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseDate    DateTime
  /// Free text — for example a supplier delivery-note or invoice number. Not
  /// normalised or unique, the same treatment as `Supplier.address`.
  reference       String?  @db.Text
  /// Sum of all item line totals. Backend-calculated, never trusted from a
  /// request, never JavaScript floating-point arithmetic.
  totalCost       Decimal  @db.Decimal(14, 2)
  createdByUserId String?
  createdByUser   User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items              PurchaseItem[]
  paymentAllocations PurchasePaymentAllocation[]

  @@index([supplierId])
  @@map("purchases")
}

/// One line of a purchase: one raw material, a quantity, and its own
/// unit-cost snapshot — see business-blueprint section 2.16.
///
/// `measurementUnitId` snapshots the raw material's unit at purchase time,
/// the same reason `RawMaterialUsage.measurementUnitId` does — a later
/// change to the raw material's configured unit must never rewrite this
/// history.
///
/// For a Pumice item, `quantity` holds the computed total volume (cubic
/// metres) and `unitCost` holds the rate per cubic metre — deliberately
/// reused rather than duplicated under Pumice-specific names, so
/// `lineTotal = quantity × unitCost` holds as one invariant for every raw
/// material. `lengthMetres`/`widthMetres`/`heightMetres`/`numberOfLoads` are
/// the only Pumice-specific data with no generic equivalent; all four stay
/// null for every other raw material.
model PurchaseItem {
  id                String          @id @default(uuid())
  purchaseId        String
  purchase          Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  rawMaterialId     String
  rawMaterial       RawMaterial     @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)
  measurementUnitId String
  measurementUnit   MeasurementUnit @relation(fields: [measurementUnitId], references: [id], onDelete: Restrict)
  quantity          Decimal         @db.Decimal(14, 3)
  unitCost          Decimal         @db.Decimal(12, 2)
  lineTotal         Decimal         @db.Decimal(14, 2)
  /// Pumice-only snapshot fields. Null for every other raw material.
  lengthMetres      Decimal?        @db.Decimal(8, 3)
  widthMetres       Decimal?        @db.Decimal(8, 3)
  heightMetres      Decimal?        @db.Decimal(8, 3)
  numberOfLoads     Int?
  createdAt         DateTime        @default(now())

  @@index([purchaseId])
  @@index([rawMaterialId])
  @@map("purchase_items")
}

/// Payment lifecycle: `PENDING` (created, does not affect the supplier
/// balance) → `APPROVED` (Admin/Super Admin only; reduces the balance) →
/// `REVERSED` (Admin/Super Admin only, written reason required; restores the
/// balance). See business-blueprint section 2.17 and
/// docs/implementation-plan.md Phase 7D. Never permanently deleted.
enum PurchasePaymentStatus {
  PENDING
  APPROVED
  REVERSED
}

/// Purchase payment. See business-blueprint sections 2.16-2.17,
/// docs/technical-blueprint.md section 4.10, and
/// docs/implementation-plan.md Phase 7D.
///
/// `paymentReference` is always required, regardless of `paymentMethod` —
/// every payment must contain valid payment information (an M-Pesa
/// transaction code, a bank-transfer reference, a cheque number/details, or
/// clear cash-payment information). The frontend changes only the field's
/// *label* per method; the backend cannot mechanically distinguish "a valid
/// M-Pesa code" from "a valid cheque number" beyond requiring a non-empty
/// descriptive string, the same opaque-free-text treatment every other
/// reference-style field in this schema already gets (e.g.
/// `Purchase.reference`).
///
/// `evidenceStoredFileId` is optional additional proof, never a substitute
/// for `paymentReference`.
model PurchasePayment {
  id                   String                @id @default(uuid())
  paymentNumber        String                @unique
  supplierId           String
  supplier             Supplier              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  amount               Decimal               @db.Decimal(14, 2)
  paymentMethod        PaymentMethod
  paymentReference     String                @db.Text
  paymentDate          DateTime
  status               PurchasePaymentStatus @default(PENDING)
  evidenceStoredFileId String?               @unique
  evidenceStoredFile   StoredFile?           @relation(fields: [evidenceStoredFileId], references: [id], onDelete: Restrict)
  approvedByUserId     String?
  approvedByUser       User?                 @relation("PurchasePaymentApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvedAt           DateTime?
  reversedByUserId     String?
  reversedByUser       User?                 @relation("PurchasePaymentReversedBy", fields: [reversedByUserId], references: [id], onDelete: SetNull)
  reversedAt           DateTime?
  /// Required for a reversal. Never set otherwise.
  reversalReason       String?               @db.Text
  createdByUserId      String?
  createdByUser        User?                 @relation("PurchasePaymentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  allocations PurchasePaymentAllocation[]

  @@index([supplierId])
  @@map("purchase_payments")
}

/// Connects a purchase payment to one or more purchase records, for
/// traceability only (technical-blueprint section 4.10: "allows payment
/// history to remain traceable without changing the purchase itself") — the
/// supplier outstanding-balance calculation always uses the payment's own
/// `amount`/`status`, never this breakdown. Every allocated purchase must
/// belong to the same supplier as the payment, and `allocatedAmount` must
/// never exceed that purchase's remaining unpaid amount
/// (`totalCost - Σ(allocatedAmount of APPROVED payments)`), re-checked fresh
/// whenever a payment is approved.
model PurchasePaymentAllocation {
  id                String          @id @default(uuid())
  purchasePaymentId String
  purchasePayment   PurchasePayment @relation(fields: [purchasePaymentId], references: [id], onDelete: Cascade)
  purchaseId        String
  purchase          Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  allocatedAmount   Decimal         @db.Decimal(14, 2)
  createdAt         DateTime        @default(now())

  @@index([purchasePaymentId])
  @@index([purchaseId])
  @@map("purchase_payment_allocations")
}

/// Company settings. See business-blueprint section 9.5 (technical blueprint)
/// and section 5 (permissions — Admin/Super Admin only).
///
/// A singleton: exactly one row, fixed at `SETTINGS_ROW_ID` in
/// settings.repository.ts. There is no create or delete endpoint, only read
/// and update. Logo is deliberately not a field yet — it needs the file-
/// storage architecture (technical-blueprint section 8), which does not exist
/// yet.
model CompanySettings {
  id             String   @id
  companyName    String?
  address        String?  @db.Text
  phone          String?
  email          String?
  paymentDetails String?  @db.Text
  footerNotes    String?  @db.Text
  updatedAt      DateTime @updatedAt

  @@map("company_settings")
}

/// See business-blueprint section 2.6. `PREPAID` orders skip the credit check
/// entirely — a fully paid order may proceed even when the customer is
/// credit-blocked. `CREDIT` orders are checked against the customer's credit
/// status. Renamed from `OrderPaymentType`'s `CASH`/`CREDIT` in Phase 6C-2
/// (2026-08-02) — cash is a payment method (business-blueprint section 2.23),
/// not this order-level arrangement. See
/// docs/decisions/business-workflow-update-2026-08-02.md section 5.
enum OrderPaymentArrangement {
  PREPAID
  CREDIT
}

/// System-controlled order status. See
/// docs/decisions/business-workflow-update-2026-08-02.md section 12.3. Never
/// user-writable — every order starts `PENDING` and moves only through
/// explicit service actions (Production, Curing, Delivery modules, and the
/// order-cancellation action added in Phase 6C-2). There is no generic
/// status-update endpoint.
enum OrderStatus {
  PENDING
  IN_PRODUCTION
  CURING
  READY_FOR_DELIVERY
  PARTIALLY_DELIVERED
  COMPLETED
  CANCELLED
}

/// Delivery status (Phase 8, 2026-08-04). See business-blueprint section
/// 2.19 and docs/implementation-plan.md §12.
///
/// PLANNED: created, stock reserved atomically, nothing else.
/// DISPATCHED: truck left the yard — physical stock reduced (Phase 8C).
/// DELIVERED: customer received the goods — OrderItem/Order updated (Phase 8D).
/// CANCELLED: only from PLANNED — reservation released (Phase 8E).
enum DeliveryStatus {
  PLANNED
  DISPATCHED
  DELIVERED
  CANCELLED
}

/// Customer credit status. See business-blueprint section 2.24. Persisted
/// only as a snapshot on `CustomerCreditOverride.previousCreditStatus` — the
/// live status is always computed, never cached or stored on `Customer`
/// (technical-blueprint section 4A.3).
enum CreditStatus {
  NORMAL
  WARNING
  STRONG_WARNING
  BLOCKED
}

/// Order master. Direct creation only — quotation removed (Phase 6C-2,
/// 2026-08-02). See business-blueprint section 2.6,
/// docs/implementation-plan.md Phase 5B/6C-2, and
/// docs/decisions/business-workflow-update-2026-08-02.md.
///
/// `status` is system-controlled: every order starts `PENDING` and moves
/// only through explicit service actions, never a plain field update. The
/// quantity fields on `OrderItem` (produced/allocated/delivered/remaining)
/// are what later phases (Production, Delivery) update.
///
/// The customer address is both a live FK (`customerAddressId`, restricted
/// so a referenced address can never be deleted) and a text snapshot
/// (`addressLabel`/`addressLine`/`addressDirections`) captured at creation —
/// editing the site later must not rewrite where an existing order was sent.
model Order {
  id                 String                  @id @default(uuid())
  orderNumber        String                  @unique
  customerId         String
  customer           Customer                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerAddressId  String
  customerAddress    CustomerAddress         @relation(fields: [customerAddressId], references: [id], onDelete: Restrict)
  /// Snapshot of the address at order time. See the model doc comment.
  addressLabel       String
  addressLine        String
  addressDirections  String?                 @db.Text
  paymentArrangement OrderPaymentArrangement
  status             OrderStatus             @default(PENDING)
  /// Written reason for cancellation. Mirrors `Quotation.statusReason`.
  statusReason       String?                 @db.Text
  /// Sum of all item line totals. Backend-calculated, never trusted from a
  /// request, never JavaScript floating-point arithmetic.
  totalAmount        Decimal                 @db.Decimal(14, 2)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  items             OrderItem[]
  creditOverrides   CustomerCreditOverride[]
  productionBatches ProductionBatch[]
  deliveries        Delivery[]
  invoice           Invoice?

  @@index([customerId])
  @@index([customerAddressId])
  @@map("orders")
}

/// One line of an order: one product, a quantity, and the price agreed for
/// this order specifically, entered at creation. See business-blueprint
/// sections 2.6 and 4.4.
///
/// `producedQuantity`/`allocatedQuantity`/`deliveredQuantity`/
/// `remainingQuantity` are part of the approved entity (technical-blueprint
/// section 4.4) but are only written by later phases (Production: Phase 6,
/// Delivery: Phase 8) — added now, defaulted, so those phases need no further
/// migration on this table, the same approach already used for
/// `Vehicle.ownershipType`.
model OrderItem {
  id                String   @id @default(uuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// Whole units — product pieces are never fractional.
  quantity          Int
  agreedUnitPrice   Decimal  @db.Decimal(12, 2)
  lineTotal         Decimal  @db.Decimal(14, 2)
  producedQuantity  Int      @default(0)
  allocatedQuantity Int      @default(0)
  deliveredQuantity Int      @default(0)
  /// Defaults to `quantity` — nothing has been delivered yet at creation.
  remainingQuantity Int
  /// Position on the order, in the order the items were entered. Same reason
  /// as `QuotationItem.sortOrder`: `createdAt` cannot order items reliably
  /// when several are created together in one nested write.
  sortOrder         Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  productionAllocations ProductionOrderAllocation[]
  deliveryItems         DeliveryItem[]
  invoiceItems          InvoiceItem[]

  @@index([orderId])
  @@map("order_items")
}

/// The customer's opening balance, corrected in place rather than
/// accumulated as history rows — the blueprint describes entering "the"
/// opening balance (business-blueprint section 2.25), not a running ledger
/// of several. Full before/after history lives in the audit log via
/// `previousData`/`updatedData`, the same pattern `CompanySettings` uses for
/// its own singleton corrections.
///
/// Not an invoice. Recalculating the customer's credit status after a change
/// is implicit: credit status is always computed live from this value, never
/// cached or stored (technical-blueprint section 4A.3).
model CustomerOpeningBalance {
  id              String   @id @default(uuid())
  customerId      String   @unique
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  amount          Decimal  @db.Decimal(14, 2)
  effectiveDate   DateTime
  reason          String   @db.Text
  enteredByUserId String?
  enteredByUser   User?    @relation(fields: [enteredByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("customer_opening_balances")
}

/// Lets a `BLOCKED` customer's new `CREDIT` order proceed anyway. Only
/// Admin/Super Admin may create one (`customer-credit:override`), always with
/// a written reason, always audited. See business-blueprint section 2.24 and
/// docs/technical-blueprint.md section 4.3.
///
/// Append-only: an override is never edited or deleted once written.
///
/// Phase 8A (2026-08-04): `relatedOrderId` became nullable and a nullable
/// `relatedDeliveryId` was added — an override now attaches to exactly one of
/// an Order or a Delivery, never both.
model CustomerCreditOverride {
  id                   String       @id @default(uuid())
  customerId           String
  customer             Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  /// Nullable since Phase 8A — an override may now attach to a Delivery instead.
  relatedOrderId       String?
  relatedOrder         Order?       @relation(fields: [relatedOrderId], references: [id], onDelete: Restrict)
  /// Added Phase 8A: the Delivery this override was created for, when it was
  /// not for an Order.
  relatedDeliveryId    String?
  relatedDelivery      Delivery?    @relation(fields: [relatedDeliveryId], references: [id], onDelete: Restrict)
  /// Snapshot of the customer's credit status at the moment of the override.
  previousCreditStatus CreditStatus
  reason               String       @db.Text
  approvedByUserId     String?
  approvedByUser       User?        @relation(fields: [approvedByUserId], references: [id], onDelete: SetNull)
  createdAt            DateTime     @default(now())

  @@index([customerId])
  @@index([relatedOrderId])
  @@index([relatedDeliveryId])
  @@map("customer_credit_overrides")
}

/// Configurable raw-material measurement unit (bag, kilogram, tonne, load,
/// cubic metre, ...). See business-blueprint section 2.13.
model MeasurementUnit {
  id             String   @id @default(uuid())
  name           String   @unique
  /// Lowercased, whitespace-collapsed — same normalisation as Product.name.
  nameNormalized String   @unique
  symbol         String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  rawMaterials      RawMaterial[]
  rawMaterialUsages RawMaterialUsage[]
  purchaseItems     PurchaseItem[]

  @@index([isActive])
  @@map("measurement_units")
}

/// Raw-material master record (cement, dust, pumice, ...). See
/// business-blueprint sections 2.12–2.14.
///
/// `reorderLevel` is optional and configurable — a low-stock alert (Phase 11)
/// only activates when it is set. Leaving it empty never blocks usage or
/// stock tracking.
model RawMaterial {
  id                String          @id @default(uuid())
  name              String          @unique
  nameNormalized    String          @unique
  measurementUnitId String
  measurementUnit   MeasurementUnit @relation(fields: [measurementUnitId], references: [id], onDelete: Restrict)
  reorderLevel      Decimal?        @db.Decimal(14, 3)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  stockBalance  RawMaterialStockBalance?
  movements     RawMaterialMovement[]
  usages        RawMaterialUsage[]
  purchaseItems PurchaseItem[]

  @@index([isActive])
  @@index([measurementUnitId])
  @@map("raw_materials")
}

/// One current balance per raw material. See technical-blueprint section 4.9.
///
/// Updated only inside a transaction holding `lockRowsForUpdate` on this row
/// — the same pessimistic-locking pattern `DocumentSequence` uses for numbering
/// — never by a bare read-then-write. `version` still increments on every
/// change, for traceability alongside the lock.
model RawMaterialStockBalance {
  id            String      @id @default(uuid())
  rawMaterialId String      @unique
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)
  quantity      Decimal     @db.Decimal(14, 3)
  version       Int         @default(0)
  updatedAt     DateTime    @updatedAt

  @@map("raw_material_stock_balances")
}

/// See business-blueprint section 2.12: "must not calculate material usage
/// using a fixed product formula" — every quantity here is entered, not
/// derived. `PURCHASE_RECEIPT` is written starting in Phase 7;
/// `PRODUCTION_USAGE` starts in Phase 6B. Both values exist now so neither
/// phase needs another migration on this table.
enum RawMaterialMovementType {
  OPENING
  PRODUCTION_USAGE
  PURCHASE_RECEIPT
  POSITIVE_ADJUSTMENT
  NEGATIVE_ADJUSTMENT
  CORRECTION
}

/// The raw-material stock ledger — the main history, per technical-blueprint
/// section 4.9.
///
/// `quantity` is signed: positive for movements that increase stock (opening,
/// purchase receipt, positive adjustment), negative for movements that
/// decrease it (production usage, negative adjustment). `correction` may be
/// either sign. `relatedEntityId` is a plain id, not a foreign key — it may
/// point at a production batch, a purchase, or nothing at all for a manual
/// adjustment, and Prisma cannot express a polymorphic relation across
/// several tables (the same reasoning as `GeneratedDocument.relatedEntityId`).
model RawMaterialMovement {
  id              String                  @id @default(uuid())
  rawMaterialId   String
  rawMaterial     RawMaterial             @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)
  movementType    RawMaterialMovementType
  quantity        Decimal                 @db.Decimal(14, 3)
  balanceAfter    Decimal                 @db.Decimal(14, 3)
  relatedEntityId String?
  /// Required for POSITIVE_ADJUSTMENT, NEGATIVE_ADJUSTMENT and CORRECTION.
  reason          String?                 @db.Text
  createdByUserId String?
  createdByUser   User?                   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime                @default(now())

  @@index([rawMaterialId])
  @@index([movementType])
  @@map("raw_material_movements")
}

/// One current balance per product. See business-blueprint section 2.9 and
/// technical-blueprint section 4.7.
///
/// `availableQuantity` is stored, not computed on read — kept equal to
/// `physicalQuantity - reservedQuantity` by the service layer on every write,
/// inside the same locked transaction, per the technical blueprint's explicit
/// field list. `reservedQuantity` is written starting in Phase 8 (Stock
/// Reservation, tied to Delivery) — the column exists now so that phase needs
/// no migration of its own.
model FinishedStockBalance {
  id                String   @id @default(uuid())
  productId         String   @unique
  product           Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  physicalQuantity  Int      @default(0)
  reservedQuantity  Int      @default(0)
  availableQuantity Int      @default(0)
  version           Int      @default(0)
  updatedAt         DateTime @updatedAt

  @@map("finished_stock_balances")
}

/// `CURING_RELEASE`/`GENERAL_STOCK_RELEASE` are written starting in Phase 6B;
/// `DELIVERY_DISPATCH` starts in Phase 8. All three exist now so neither phase
/// needs another migration on this table.
enum FinishedStockMovementType {
  OPENING
  CURING_RELEASE
  GENERAL_STOCK_RELEASE
  DELIVERY_DISPATCH
  BROKEN
  POSITIVE_ADJUSTMENT
  NEGATIVE_ADJUSTMENT
  CORRECTION
}

/// The finished-stock ledger — the main history, per technical-blueprint
/// section 4.7. Same signed-quantity and polymorphic `relatedEntityId`
/// reasoning as `RawMaterialMovement`.
model FinishedStockMovement {
  id              String                    @id @default(uuid())
  productId       String
  product         Product                   @relation(fields: [productId], references: [id], onDelete: Restrict)
  movementType    FinishedStockMovementType
  quantity        Int
  balanceAfter    Int
  relatedEntityId String?
  /// Required for POSITIVE_ADJUSTMENT, NEGATIVE_ADJUSTMENT and CORRECTION.
  reason          String?                   @db.Text
  createdByUserId String?
  createdByUser   User?                     @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime                  @default(now())

  @@index([productId])
  @@index([movementType])
  @@map("finished_stock_movements")
}

/// See business-blueprint section 2.11: broken products are recorded during
/// production, curing, finished-stock handling, and delivery handling.
/// `FINISHED_STOCK` recording ships now (broken-stock adjustments);
/// `PRODUCTION`/`CURING` writers start in Phase 6B; `DELIVERY` starts in
/// Phase 8. All four values exist now so no later phase needs a migration
/// just to add its own stage.
enum BrokenProductStage {
  PRODUCTION
  CURING
  FINISHED_STOCK
  DELIVERY
}

/// Broken-product record. `relatedEntityId` is a plain id, not a foreign key
/// — it may point at a production item, a curing record, a stock movement,
/// or a delivery, depending on `stage` (the same polymorphic-id reasoning as
/// `RawMaterialMovement.relatedEntityId`).
model BrokenProductRecord {
  id               String             @id @default(uuid())
  productId        String
  product          Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity         Int
  stage            BrokenProductStage
  relatedEntityId  String?
  reason           String?            @db.Text
  recordedByUserId String?
  recordedByUser   User?              @relation(fields: [recordedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime           @default(now())

  @@index([productId])
  @@index([stage])
  @@map("broken_product_records")
}

/// See business-blueprint section 2.7: production is created either for a
/// specific order, or for general finished stock — never both, and never
/// neither.
enum ProductionPurpose {
  ORDER
  GENERAL_STOCK
}

/// Computed, never accepted from a request. Flips to `COMPLETED` once every
/// item's curing has been released — see `curing.service.ts`.
enum ProductionStatus {
  IN_PROGRESS
  COMPLETED
}

/// Production run. See business-blueprint section 2.7 and
/// docs/implementation-plan.md Phase 6B.
model ProductionBatch {
  id               String            @id @default(uuid())
  productionNumber String            @unique
  productionDate   DateTime
  purpose          ProductionPurpose
  /// Required when `purpose` is `ORDER`, absent when `GENERAL_STOCK`.
  orderId          String?
  order            Order?            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  status           ProductionStatus  @default(IN_PROGRESS)
  createdByUserId  String?
  createdByUser    User?             @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  items             ProductionItem[]
  rawMaterialUsages RawMaterialUsage[]

  @@index([orderId])
  @@index([status])
  @@map("production_batches")
}

/// One product's line within a production run. See business-blueprint
/// section 2.7.
///
/// `allocatedQuantity`/`excessQuantity` are the **planned** split against the
/// order, computed at production time — the split actually credited to
/// finished stock is computed at curing release (`curing.service.ts`),
/// because further breakage may occur during curing.
model ProductionItem {
  id                String          @id @default(uuid())
  productionBatchId String
  productionBatch   ProductionBatch @relation(fields: [productionBatchId], references: [id], onDelete: Cascade)
  productId         String
  product           Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  pallets           Int
  /// `pallets × 12`, backend-calculated.
  producedQuantity  Int
  /// Broken before curing — a separate capture point from
  /// `CuringRecord.brokenQuantity`, which captures breakage *during* curing.
  brokenQuantity    Int             @default(0)
  /// `producedQuantity − brokenQuantity`. This is what enters curing.
  usableQuantity    Int
  allocatedQuantity Int             @default(0)
  excessQuantity    Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  allocations  ProductionOrderAllocation[]
  curingRecord CuringRecord?

  @@index([productionBatchId])
  @@index([productId])
  @@map("production_items")
}

/// Connects a production item to the order item it was produced for, and the
/// exact quantity earmarked. See business-blueprint section 2.7 and
/// technical-blueprint section 4.6.
model ProductionOrderAllocation {
  id               String         @id @default(uuid())
  productionItemId String
  productionItem   ProductionItem @relation(fields: [productionItemId], references: [id], onDelete: Cascade)
  orderItemId      String
  orderItem        OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  quantity         Int
  createdAt        DateTime       @default(now())

  @@index([productionItemId])
  @@index([orderItemId])
  @@map("production_order_allocations")
}

/// Actual raw-material quantity used in a production run — never a fixed
/// formula (business-blueprint section 2.12). `measurementUnitId` snapshots
/// the raw material's unit at the time of entry, so a later change to the
/// raw material's configured unit never rewrites this history.
model RawMaterialUsage {
  id                String          @id @default(uuid())
  productionBatchId String
  productionBatch   ProductionBatch @relation(fields: [productionBatchId], references: [id], onDelete: Cascade)
  rawMaterialId     String
  rawMaterial       RawMaterial     @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)
  measurementUnitId String
  measurementUnit   MeasurementUnit @relation(fields: [measurementUnitId], references: [id], onDelete: Restrict)
  quantity          Decimal         @db.Decimal(14, 3)
  createdAt         DateTime        @default(now())

  @@index([productionBatchId])
  @@index([rawMaterialId])
  @@map("raw_material_usages")
}

/// The only two selectable curing durations. See business-blueprint section
/// 2.8 — deliberately just these two values: the shorter one is also the
/// absolute floor a curing record can never release before.
enum CuringDuration {
  TWO_DAYS
  THREE_DAYS
}

/// Belongs to exactly one production item. See business-blueprint section
/// 2.8.
///
/// Release requires `now >= plannedCompletion` — using whichever duration is
/// currently selected. The only way to release a `THREE_DAYS` record before
/// the full three days is the explicit, audited change-to-`TWO_DAYS` action;
/// there is no separate early-release override.
model CuringRecord {
  id                   String         @id @default(uuid())
  productionItemId     String         @unique
  productionItem       ProductionItem @relation(fields: [productionItemId], references: [id], onDelete: Restrict)
  /// Denormalised from `productionItem.productionBatchId`, so a batch's
  /// completion can be checked with a query against this table alone —
  /// avoids `curing` needing to read `production`'s tables directly.
  productionBatchId    String
  quantityEntering     Int
  originalDuration     CuringDuration
  currentDuration      CuringDuration
  startedAt            DateTime
  plannedCompletion    DateTime
  actualRelease        DateTime?
  /// Broken during curing — set at release time, alongside `releasedQuantity`.
  brokenQuantity       Int            @default(0)
  /// `quantityEntering − brokenQuantity`. Null until released.
  releasedQuantity     Int?
  /// Required when `currentDuration` differs from `originalDuration`.
  durationChangeReason String?        @db.Text
  changedByUserId      String?
  changedByUser        User?          @relation("CuringDurationChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)
  changedAt            DateTime?
  releasedByUserId     String?
  releasedByUser       User?          @relation("CuringReleasedBy", fields: [releasedByUserId], references: [id], onDelete: SetNull)
  createdByUserId      String?
  createdByUser        User?          @relation("CuringCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([productionItemId])
  @@index([productionBatchId])
  @@map("curing_records")
}

/// Delivery trip (Phase 8, 2026-08-04). See business-blueprint section 2.19
/// and docs/implementation-plan.md §12.
///
/// One order + one customer address (snapshotted) + one driver + one vehicle
/// per delivery. The payee is the Vehicle Owner linked to the selected Vehicle
/// at creation time, snapshotted so a later edit never rewrites history.
///
/// Transport snapshot columns exist now for safe database design but are only
/// written starting in Phase 8B (trip count) / 8C (dispatch).
model Delivery {
  id             String   @id @default(uuid())
  deliveryNumber String   @unique
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // Address snapshot (same pattern as Order)
  customerAddressId String
  customerAddress   CustomerAddress @relation(fields: [customerAddressId], references: [id], onDelete: Restrict)
  addressLabel      String
  addressLine       String
  addressDirections String?         @db.Text

  // Driver and Vehicle selected separately — no permanent pairing
  driverId  String
  driver    Driver  @relation(fields: [driverId], references: [id], onDelete: Restrict)
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  // Payee snapshot (resolved from Vehicle → VehicleOwner at creation)
  vehicleOwnerId String
  vehicleOwner   VehicleOwner @relation(fields: [vehicleOwnerId], references: [id], onDelete: Restrict)
  payeeName      String
  payeePhone     String

  deliveryDate DateTime

  status DeliveryStatus @default(PLANNED)

  // Transport snapshot columns (written starting in Phase 8B/8C; NULL until then)
  transportRate             Decimal? @db.Decimal(12, 2)
  numberOfTrips             Int?
  totalTransportCost        Decimal? @db.Decimal(14, 2)
  maxPiecesPerTruckSnapshot Int?

  // Cancellation (Phase 8E)
  cancelledReason   String?   @db.Text
  cancelledByUserId String?
  cancelledByUser   User?     @relation("DeliveryCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  cancelledAt       DateTime?

  // Dispatch (Phase 8C)
  dispatchedByUserId String?
  dispatchedByUser   User?     @relation("DeliveryDispatchedBy", fields: [dispatchedByUserId], references: [id], onDelete: SetNull)
  dispatchedAt       DateTime?

  // Completion (Phase 8D)
  completedAt DateTime?

  // Correction (Phase 8F)
  correctionReason String? @db.Text

  createdByUserId String?
  createdByUser   User?    @relation("DeliveryCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items           DeliveryItem[]
  creditOverrides CustomerCreditOverride[]

  @@index([orderId])
  @@index([customerId])
  @@index([driverId])
  @@index([vehicleId])
  @@index([createdAt])
  @@index([status])
  @@map("deliveries")
}

/// One line of a delivery: an order item, the quantity this delivery commits
/// to for it, and the product (denormalised from the order item for fast
/// stock queries). See docs/technical-blueprint.md section 4.11 and
/// docs/implementation-plan.md §12.
///
/// @@unique([deliveryId, orderItemId]) prevents the same OrderItem from
/// appearing twice in one delivery.
model DeliveryItem {
  id          String    @id @default(uuid())
  deliveryId  String
  delivery    Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  /// What this delivery commits to for this line.
  plannedQuantity  Int
  /// Mirrors plannedQuantity while PLANNED; zeroed at DISPATCHED or CANCELLED.
  reservedQuantity Int

  /// Set at DISPATCHED (Phase 8C) — normally equals plannedQuantity.
  dispatchedQuantity Int @default(0)
  /// Set at DELIVERED (Phase 8D) — actual quantity received.
  deliveredQuantity  Int @default(0)
  /// Set at DELIVERED (Phase 8D) — broken during transit.
  brokenQuantity     Int @default(0)

  sortOrder Int
  createdAt DateTime @default(now())

  @@unique([deliveryId, orderItemId])
  @@index([deliveryId])
  @@index([orderItemId])
  @@index([productId])
  @@map("delivery_items")
}

// --- Phase 9A: Invoices ----------------------------------------------------

enum InvoiceStatus {
  ISSUED
  VOIDED
}

model Invoice {
  id              String        @id @default(uuid())
  invoiceNumber   String        @unique
  orderId         String        @unique
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status          InvoiceStatus @default(ISSUED)
  totalAmount     Decimal       @db.Decimal(14, 2)
  dueDate         DateTime
  voidedAt        DateTime?
  voidedByUserId  String?
  voidedByUser    User?         @relation("InvoiceVoidedBy", fields: [voidedByUserId], references: [id], onDelete: SetNull)
  voidReason      String?       @db.Text
  createdByUserId String?
  createdByUser   User?         @relation("InvoiceCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items       InvoiceItem[]
  allocations CustomerPaymentAllocation[]

  @@index([orderId])
  @@index([customerId])
  @@index([createdAt])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id          String    @id @default(uuid())
  invoiceId   String
  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName String
  quantity    Int
  unitPrice   Decimal   @db.Decimal(12, 2)
  lineTotal   Decimal   @db.Decimal(14, 2)
  sortOrder   Int
  createdAt   DateTime  @default(now())

  @@index([invoiceId])
  @@map("invoice_items")
}

// --- Phase 9B: Customer Payments -------------------------------------------

/// Receipt status. ACTIVE until the payment is reversed.
enum ReceiptStatus {
  ACTIVE
  VOIDED
}

/// Customer payment. PENDING → APPROVED → REVERSED (PaymentStatus already
/// exists from Phase 7D purchase payments). See docs/implementation-plan.md §9B.
model CustomerPayment {
  id                   String                @id @default(uuid())
  paymentNumber        String                @unique
  customerId           String
  customer             Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  amount               Decimal               @db.Decimal(14, 2)
  paymentMethod        PaymentMethod
  /// Required for M_PESA, BANK_TRANSFER, CHEQUE; optional for CASH.
  paymentReference     String?
  /// Optional permanent evidence file.
  evidenceStoredFileId String?               @unique
  evidenceStoredFile   StoredFile?           @relation("CustomerPaymentEvidence", fields: [evidenceStoredFileId], references: [id], onDelete: Restrict)
  status               PurchasePaymentStatus @default(PENDING)
  recordedByUserId     String?
  recordedByUser       User?                 @relation("PaymentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  approvedByUserId     String?
  approvedByUser       User?                 @relation("PaymentApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvedAt           DateTime?
  reversedByUserId     String?
  reversedByUser       User?                 @relation("PaymentReversedBy", fields: [reversedByUserId], references: [id], onDelete: SetNull)
  reversedAt           DateTime?
  reversalReason       String?               @db.Text
  paymentDate          DateTime

  receipt     Receipt?
  allocations CustomerPaymentAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([createdAt])
  @@map("customer_payments")
}

/// Connects a payment to one or more invoices. Traceability only — the
/// customer balance is computed from the payment's own amount and status.
model CustomerPaymentAllocation {
  id        String          @id @default(uuid())
  paymentId String
  payment   CustomerPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount    Decimal         @db.Decimal(14, 2)

  @@unique([paymentId, invoiceId])
  @@map("customer_payment_allocations")
}

/// Receipt issued when a payment is approved. ACTIVE until payment reversal.
model Receipt {
  id                          String          @id @default(uuid())
  receiptNumber               String          @unique
  paymentId                   String          @unique
  payment                     CustomerPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  customerId                  String
  customer                    Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  amount                      Decimal         @db.Decimal(14, 2)
  customerBalanceAfterPayment Decimal         @db.Decimal(14, 2)
  status                      ReceiptStatus   @default(ACTIVE)
  issuedByUserId              String?
  issuedByUser                User?           @relation("ReceiptIssuedBy", fields: [issuedByUserId], references: [id], onDelete: SetNull)
  issuedAt                    DateTime
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt

  @@map("receipts")
}

model Expense {
  id                   String          @id @default(uuid())
  expenseNumber        String          @unique
  category             ExpenseCategory
  description          String          @db.Text
  amount               Decimal         @db.Decimal(14, 2)
  paymentMethod        PaymentMethod
  paymentReference     String?
  expenseDate          DateTime
  evidenceStoredFileId String?         @unique
  evidenceStoredFile   StoredFile?     @relation("ExpenseEvidence", fields: [evidenceStoredFileId], references: [id], onDelete: Restrict)
  recordedByUserId     String?
  recordedByUser       User?           @relation("ExpenseRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@map("expenses")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?  @db.Text
  userAgent      String?  @db.Text
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?  @db.Text

  @@unique([token])
  @@index([userId(length: 191)])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @db.Text
  providerId            String    @db.Text
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId(length: 191)])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String   @db.Text
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier(length: 191)])
  @@map("verification")
}
